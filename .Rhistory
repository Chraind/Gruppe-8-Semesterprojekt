mutate(
# Ugedag som faktor (bevar evt. rækkefølgen)
ugedag = factor(ugedag,
levels = c("Man", "Tir", "Ons", "Tor", "Fre", "Lør", "Søn"),
ordered = TRUE),
# Tidsgruppe som faktor
tidsgruppe = factor(tidsgruppe,
levels = c("tidligt", "midt", "sent"),
ordered = FALSE),
# Seneste kamp som faktor
seneste_kamp = factor(seneste_kamp,
levels = c("vundet", "uafgjort", "tabt")),
# Regn: inddelt i "ingen", "lidt", "meget"
regn_gruppe = case_when(
is.na(regn)        ~ NA_character_,
regn == 0          ~ "ingen regn",
regn > 0 & regn <= 1 ~ "lidt regn",
regn > 1           ~ "meget regn"
) %>% factor(levels = c("ingen regn", "lidt regn", "meget regn"))
)
# Helligdag som logisk faktor
joined_data <- joined_data %>%
mutate(
helligdag = ifelse(is.na(helligdag), 0, 1)
)
# Runde som double
joined_data <- joined_data %>%
mutate(
runde = as.numeric(gsub("Runde ", "", runde))
)
joined_data <- joined_data %>%
mutate(
# Find befolkningstal for første kamp i 2003
basis_befolkning = first(Indbyggere_Viborg_Kommune),
# Beregn akkumuleret vækst fra 2003
akk_indbyggertal = Indbyggere_Viborg_Kommune - basis_befolkning
) %>%
# Fjern basis_befolkning hjælpekolonne
dplyr::select(-basis_befolkning)
# Find gennemsnitlige tilskuere per kamp
matchup_attendance <- joined_data %>%
group_by(kamp) %>%
summarise(
avg_tilskuere = mean(tilskuere, na.rm = TRUE)
)
# Inddel holdene i grupper baseret på tilskuer antal
matchup_attendance <- matchup_attendance %>%
mutate(
kamp_gruppe = case_when(
avg_tilskuere <= 4000 ~ "lille",
avg_tilskuere > 4000 & avg_tilskuere <= 5500 ~ "middel",
avg_tilskuere > 5500 ~ "stor"
),
kamp_gruppe = factor(kamp_gruppe, levels = c("lille", "middel", "stor"))
)
# Join med det andet data
joined_data <- joined_data %>%
left_join(matchup_attendance %>% select(kamp, kamp_gruppe), by = "kamp")
view(joined_data)
# TODO: lav en gruppe til sommerferie, vinterferie, sæt den sammen med helligdag
# 1️⃣ Define holiday periods per year (like before)
holiday_weeks <- tibble(
ferie_name = c("vinterferie", "påskeferie", "sommerferie", "efterårsferie", "juleferie"),
start_week = c(7, 14, 26, 42, 52),
end_week   = c(8, 15, 31, 42, 1)
)
years <- joined_data %>% pull(år) %>% unique() %>% sort()
ferie_perioder <- data.frame()
for(y in years) {
for(i in 1:nrow(holiday_weeks)) {
start_date <- as.Date(paste0(y, "-01-01")) + weeks(holiday_weeks$start_week[i] - 1) - days(wday(as.Date(paste0(y, "-01-01"))) - 2)
end_date <- as.Date(paste0(y, "-01-01")) + weeks(holiday_weeks$end_week[i] - 1) - days(wday(as.Date(paste0(y, "-01-01"))) - 2)
# Adjust juleferie that spills into next year
if(holiday_weeks$ferie_name[i] == "juleferie" & end_date < start_date) {
end_date <- as.Date(paste0(y + 1, "-01-01"))
}
ferie_perioder <- rbind(ferie_perioder, data.frame(
year = y,
ferie_name = holiday_weeks$ferie_name[i],
start = start_date,
end = end_date
))
}
}
# 2️⃣ Check for holidays without creating extra rows
joined_data <- joined_data %>%
rowwise() %>%   # check each row individually
mutate(
ferie_name = {
match <- ferie_perioder %>%
filter(year == år & kamp_dato >= start & kamp_dato <= end) %>%
pull(ferie_name)
if(length(match) > 0) match[1] else NA_character_
},
ferie_flag = ifelse(!is.na(ferie_name) | helligdag == 1, 1, 0)
) %>%
ungroup()
view(joined_data)
