formula,
data = train,
scale = TRUE,
validation = "CV"
)
pls.pred <- predict(pls.fit, newdata = test, ncomp = 10)
pls_rmse <- sqrt(mean((pls.pred - y_test)^2))
# ============================================================
# RETURN RESULTS
# ============================================================
