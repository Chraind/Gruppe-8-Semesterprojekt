# ---------------------------------------------------------
# HELPER: PREDICT FOR REGSUBSETS (your own function)
# ---------------------------------------------------------
predict.regsubsets <- function(object, newdata, id, ...) {
form <- as.formula(object$call[[2]])
mat <- model.matrix(form, newdata)
coefi <- coef(object, id = id)
xvars <- names(coefi)
mat[, xvars] %*% coefi
}
# ---------------------------------------------------------
# MAIN MODEL FUNCTION (Best subset, Ridge, Lasso, PCR, PLS)
# ---------------------------------------------------------
run_all_models <- function(df, response) {
formula <- as.formula(paste(response, "~ ."))
# TRAIN/TEST SPLIT
set.seed(8)
n <- nrow(df)
train_idx <- sample(1:n, n * 2/3)
train <- df[train_idx, ]
test <- df[-train_idx, ]
y_test <- test[[response]]
# -------------------------------------------------------
# BEST SUBSET SELECTION WITH CV
# -------------------------------------------------------
k <- 10
folds <- sample(rep(1:k, length=nrow(train)))
cv.errors <- matrix(NA, k, ncol(train)-1)
for (j in 1:k) {
best.fit.cv <- regsubsets(
formula,
data = train[folds != j, ],
nvmax = ncol(train)-1
)
for (i in 1:(ncol(train)-1)) {
pred <- predict(best.fit.cv, train[folds == j, ], id=i)
cv.errors[j, i] <- mean((train[[response]][folds == j] - pred)^2)
}
}
best.size <- which.min(apply(cv.errors, 2, mean))
reg.best <- regsubsets(formula, data=train, nvmax=ncol(train)-1)
best.pred <- predict(reg.best, test, id=best.size)
rmse_best <- sqrt(mean((best.pred - y_test)^2))
# -------------------------------------------------------
# RIDGE REGRESSION
# -------------------------------------------------------
x <- model.matrix(formula, df)[, -1]
y <- df[[response]]
ridge_cv <- cv.glmnet(x[train_idx, ], y[train_idx], alpha=0)
ridge_pred <- predict(ridge_cv, newx=x[-train_idx, ], s="lambda.min")
rmse_ridge <- sqrt(mean((ridge_pred - y_test)^2))
# -------------------------------------------------------
# LASSO REGRESSION
# -------------------------------------------------------
lasso_cv <- cv.glmnet(x[train_idx, ], y[train_idx], alpha=1)
lasso_pred <- predict(lasso_cv, newx=x[-train_idx, ], s="lambda.min")
rmse_lasso <- sqrt(mean((lasso_pred - y_test)^2))
# -------------------------------------------------------
# PCR
# -------------------------------------------------------
pcr_fit <- pcr(
formula,
data=df,
subset=train_idx,
scale=TRUE,
validation="CV",
segments=10
)
pcr_pred <- predict(pcr_fit, x[-train_idx, ], ncomp=min(25, ncol(df)-1))
rmse_pcr <- sqrt(mean((pcr_pred - y_test)^2))
# -------------------------------------------------------
# PLS
# -------------------------------------------------------
pls_fit <- plsr(
formula,
data=df,
subset=train_idx,
scale=TRUE,
validation="CV",
segments=10
)
pls_pred <- predict(pls_fit, x[-train_idx, ], ncomp=1)
rmse_pls <- sqrt(mean((pls_pred - y_test)^2))
# -------------------------------------------------------
# RETURN RESULTS
# -------------------------------------------------------
tibble(
model = c("Best Subset", "Ridge", "Lasso", "PCR", "PLS"),
RMSE  = c(rmse_best, rmse_ridge, rmse_lasso, rmse_pcr, rmse_pls)
)
}
# ---------------------------------------------------------
# RUN MODELS FOR ALL TARGET VARIABLES
# ---------------------------------------------------------
results_tilskuere <- run_all_models(vff_variabler, "tilskuere")
