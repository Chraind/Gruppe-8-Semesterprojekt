# Flag til sommerferie, vinterferie, sæt den sammen med helligdag
joined_data <- joined_data %>%
mutate(
# Flag if kamp_dato falls in any school holiday
ferie_flag = ifelse(
# vinterferie (mid-February)
between(kamp_dato, as.Date(paste0(år,"-02-11")), as.Date(paste0(år,"-02-17"))) |
# påskeferie (mid-April)
between(kamp_dato, as.Date(paste0(år,"-04-15")), as.Date(paste0(år,"-04-21"))) |
# sommerferie (late June – early August)
between(kamp_dato, as.Date(paste0(år,"-06-25")), as.Date(paste0(år,"-08-10"))) |
# efterårsferie (mid-October)
between(kamp_dato, as.Date(paste0(år,"-10-14")), as.Date(paste0(år,"-10-20"))) |
# juleferie (late Dec – early Jan next year)
(kamp_dato >= as.Date(paste0(år,"-12-23")) & kamp_dato <= as.Date(paste0(år+1,"-01-01"))) |
# helligdag column
helligdag == 1,
1, 0
)
)
view(joined_data)
