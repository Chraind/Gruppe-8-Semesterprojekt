# Tilføj til tibble
kombineret_runde_table <- bind_rows(kombineret_runde_table, df)
}
}
}, error = function(e) {
# Denne del kører kun hvis der sker en fejl
cat(" Fejl ved hentning af data for", year, ":", e$message, "\n")
})
view(kombineret_runde_table)
