modstander_score = ifelse(grepl("^(VFF|Viborg)", kamp), score_away, score_home),
vff_vundet = case_when(
vff_score > modstander_score ~ "vundet",
vff_score < modstander_score ~ "tabt",
TRUE ~ "uafgjort"
)
) %>%
